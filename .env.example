# Required for the Telegram control layer
TELEGRAM_BOT_TOKEN=

# Optional Heroku deployment/update credentials
HEROKU_API_KEY=
HEROKU_APP_NAME=

# GitHub repository used by the /update command
UPDATE_GITHUB_OWNER=Tohidkhan6332
UPDATE_GITHUB_REPO=TOHID-BUG
