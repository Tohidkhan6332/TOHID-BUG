# Required for the Telegram control layer
TELEGRAM_BOT_TOKEN=

# Optional Heroku deployment/update credentials
HEROKU_API_KEY=
HEROKU_APP_NAME=

# GitHub repository used by the /update command
UPDATE_GITHUB_OWNER=Tohidkhan6332
UPDATE_GITHUB_REPO=TOHID-BUG
UPDATE_GITHUB_BRANCH=main

# TOHID-AI provider credentials
# Never commit a real credential. Put real values only in local .env or hosting secrets.
AGNES_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_KEY=
OPENROUTER_NEURO_API_KEY=
POLLINATIONS_API_KEY=

# Optional provider model overrides
AGNES_MODEL=agnes-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_NEURO_MODEL=openrouter/auto
AI_GATEWAY_MODEL=openai/gpt-4o-mini
VERCEL_AI_GATEWAY_MODEL=openai/gpt-4o-mini
POLLINATIONS_MODEL=openai

# Optional endpoint overrides; defaults are already built into the provider.
AGNES_API_URL=https://apihub.agnes-ai.com/v1/chat/completions
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_NEURO_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_GATEWAY_API_URL=https://ai-gateway.vercel.sh/v1/chat/completions
PREXZY_AI_URL=https://prexzyapis.com/ai/ch
POLLINATIONS_AI_URL=https://text.pollinations.ai/openai
OPENROUTER_SITE_URL=https://github.com/Tohidkhan6332/TOHID-BUG

# Provider request timeout. The code clamps this to 5-120 seconds.
TOHID_AI_TIMEOUT_MS=20000
