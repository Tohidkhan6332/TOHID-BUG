# Unified owner authorization config
# WhatsApp uses the owner phone number; Telegram uses numeric user IDs.
WHATSAPP_OWNER_NUMBER=917849917350
TELEGRAM_OWNER_IDS=8582350365

# Direct .githubai write mode (keep the token only in hosting secrets)
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_WRITE_ENABLED=false
GITHUB_WRITE_REPOS=Tohidkhan6332/TOHID-BUG
GITHUB_COMMIT_NAME=TOHID-AI GitHub Agent
GITHUB_COMMIT_EMAIL=tohid-ai-agent@users.noreply.github.com
